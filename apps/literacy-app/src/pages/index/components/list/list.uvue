<template>
  <view class="section-header">
    <text class="section-title">📚 我的物品</text>
    <text class="section-count">{{ materials.length }}样</text>
  </view>

  <view class="grid">
    <view
      class="card"
      v-for="material in materials"
      :key="material.id"
    >
      <!-- 点击整个卡片跳转到详情 -->
      <view class="card-body" @click="gotoTask(material.id)">
        <view class="cover" :style="{ backgroundImage: material.id }">
          <image class="cover-image" :src="material.id" />
        </view>
        <view class="info">
          <text class="title">{{ material.title }}</text>
          <view class="meta">
            <text class="char-badge">{{ material.chars.length }} 个生字</text>
            <text class="progress">{{ material.progress }}</text>
          </view>
        </view>
      </view>
      
      <!-- Kindle 推送按钮 -->
      <view class="kindle-row">
        <button 
          class="kindle-btn" 
          :loading="pushingId === material.id"
          :disabled="pushingId === material.id"
          @click.stop="pushToKindle(material)"
        >
          <text class="kindle-icon">📖</text>
          <text>{{ pushingId === material.id ? '推送中...' : '推送到 Kindle' }}</text>
        </button>
      </view>
    </view>
  </view>
</template>

<script setup lang="ts">
import { onShow } from '@dcloudio/uni-app';
import { ocrState } from '@/stores/ocr';
import { ref } from 'vue';
import { Material } from '@literacy/shared-types';

const materials = ref<Array<Material>>([]);
const pushingId = ref<string | null>(null); // 正在推送的 ID

onShow(() => {
  const data = ocrState.list;
  if (data && data.length > 0) {
    materials.value = data;
  }
});

function gotoTask(id: string) {
  uni.navigateTo({ url: '/pages/literacy/literacy?id=' + id });
}

/**
 * 推送到 Kindle
 */
async function pushToKindle(material: Material) {
  // 防止重复点击
  if (pushingId.value === material.id) return;
  
  pushingId.value = material.id;
  
  try {
    // 这里假设你的后端服务地址，根据实际情况修改
    const baseUrl = 'https://your-server.com'; // ← 改成你的服务器地址
    
    const res = await uni.request({
      url: `${baseUrl}/push`,
      method: 'POST',
      data: {
        // 传给后端的文章信息
        title: material.title,
        content: material.content || '', // 如果有正文内容
        url: material.url || '',         // 如果有原文链接
        // 也可以传 ID，让后端自己去拉数据
        id: material.id
      },
      timeout: 30000 // 抓取文章可能需要一些时间
    });
    
    if (res.data.success) {
      uni.showToast({
        title: `《${material.title}》已推送到 Kindle`,
        icon: 'success',
        duration: 2500
      });
    } else {
      throw new Error(res.data.error || '推送失败');
    }
    
  } catch (error: any) {
    uni.showToast({
      title: error.message || '推送失败，请重试',
      icon: 'none',
      duration: 2000
    });
    
  } finally {
    pushingId.value = null;
  }
}
</script>

<style>
/* ===== 区块标题 ===== */
.section-header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  padding: 36rpx 40rpx 8rpx;
}

.section-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #5b4b8a;
}

.section-count {
  font-size: 22rpx;
  color: #b08850;
  background-color: #ffedd5;
  padding: 8rpx 18rpx;
  border-radius: 999rpx;
}

/* ===== 绘本网格 ===== */
.grid {
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 0 30rpx;
}

.card {
  width: 48%;
  background-color: #ffffff;
  border-radius: 28rpx;
  margin-top: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 20rpx rgba(255, 182, 193, 0.15);
}

.card-body {
  /* 点击跳转的区域 */
}

.cover {
  height: 210rpx;
  align-items: center;
  justify-content: center;
}

.cover-image {
  width: 100%;
  height: 100%;
}

.info {
  padding: 20rpx;
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333333;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.meta {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-top: 14rpx;
}

.char-badge {
  font-size: 20rpx;
  color: #ff6b81;
  background-color: #fff0f3;
  padding: 6rpx 14rpx;
  border-radius: 999rpx;
}

.progress {
  font-size: 18rpx;
}

/* ===== Kindle 按钮样式 ===== */
.kindle-row {
  padding: 0 20rpx 20rpx;
}

.kindle-btn {
  width: 100%;
  height: 56rpx;
  line-height: 56rpx;
  font-size: 22rpx;
  color: #ffffff;
  background: linear-gradient(135deg, #ff9900, #ff7700);
  border: none;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  padding: 0;
}

.kindle-btn::after {
  border: none;
}

.kindle-btn[disabled] {
  opacity: 0.6;
}

.kindle-icon {
  font-size: 26rpx;
}
</style>