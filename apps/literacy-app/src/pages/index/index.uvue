<template>
	<view class="page">
		<!-- <custom-nav /> -->
		<view class="content">
			<dec></dec>
			<view class="clear-section">
				<button class="clear-btn" @tap="clearOcrData">清除OCR缓存数据</button>
			</view>
			<!-- 快捷入口 -->
			<view class="quick">
				<view class="quick-card" @click="gotoOcr">
					<view class="quick-icon">
						<text class="quick-emoji">📷</text>
					</view>
					<view class="quick-texts">
						<text class="quick-title">拍一拍，找生字</text>
						<text class="quick-desc">家长拍照，自动识别出宝宝要学的生字</text>
					</view>
					<text class="quick-arrow">›</text>
				</view>
			</view>
			<list></list>
		</view>
	</view>
</template>
<script setup lang="ts">
	import Dec from '@/components/dec/dec.vue';
	import List from './components/list/list.vue';

	import { clearOcrResult } from '@/stores/ocr';
	import customNav from '@/components/custom-nav/custom-nav.vue'

	function clearOcrData() {
		uni.showModal({
			title: '提示',
			content: '确定清除OCR缓存数据吗？（包括图片和文字记录）',
			success: (res) => {
				if (res.confirm) {
					clearOcrResult(); // 清除 Pinia 状态 + Storage
					uni.showToast({ title: '已清除', icon: 'success' });
				}
			}
		});
	}

	function gotoOcr(id : number) {
		uni.navigateTo({ url: '/pages/ocr/ocr' })
	}
</script>
