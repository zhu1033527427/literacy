<template>
  <view class="page">
    <view class="topbar">
      <view class="back-btn" hover-class="back-hover" @click="goBack">
        <text class="back-arrow">‹</text>
      </view>
      <view class="topbar-info">
        <text class="task-name">
          {{ info.title }}
        </text>
        <text class="char-count">第 {{ info.progress + 1 }} / {{ info.l }} 个字</text>
      </view>
      <StepFlow :stage="stage" @change="onStageChange" readonly />
    </view>

    <Learn v-if="stage === 'Learn'" :char-info="charInfo" :strokes="strokes" :size="size" />
    <Write
      v-else-if="stage === 'Write'"
      :char-info="charInfo"
      :strokes="strokes"
      :size="size"
      :points="points"
    />
    <Recognize v-else-if="stage === 'Recognize'" :charInfo="info.char" />

    <view v-if="stage !== 'Recognize'" class="fab" hover-class="fab-hover" @click="onFab">
      <text class="fab-label">下一步</text>
      <text class="fab-arrow">›</text>
    </view>
  </view>
</template>
<script setup lang="uts">
import { ref, computed, watch } from "vue";
import { onShow } from "@dcloudio/uni-app";
import { ocrState } from "@/stores/ocr";
import StepFlow from "./components/StepFlow/StepFlow.uvue";
import Learn from "./components/Learn/Learn.uvue";
import Write from "./components/Write/Write.uvue";
import Recognize from "./components/Recognize/Recognize.uvue";
import { Material, StrokeData, CharDetail } from "@literacy/shared-types";
import { getCharInfo } from "@/api/char.ts";
import { loadStrokeData, Stroke } from "@/utils/write";

type Stage = "Learn" | "Write" | "Recognize";
type CharAssets = {
  detail: CharDetail | null;
  strokes: Array<Stroke> | null;
};

const STROKE_COLOR_RADICAL = "#e06a4d";
const STROKE_COLOR_NORMAL = "#35543f";

const DEFAULT_MATERIAL_ID = "http://store/L9JwhD1E0p7Bf82f69021db84c1d0b1f0a3c6d2e77c8.jpg";
const DEBUG_CHAR = "丁"; // 调试阶段先写死；上线改为按 progress 取值

const stage = ref<Stage>("Write");
const material = ref<Material | null>(null);
const charInfo = ref<CharDetail | null>(null);
const strokes = ref<Array<Stroke> | null>(null);
const size = ref("548");

const info = computed(() => {
  const m = material.value;
  const chars = m?.chars ?? "";
  // const char = chars[m?.progress ?? 0] ?? "";
  const char = DEBUG_CHAR;
  return {
    id: m?.id ?? "",
    title: m?.title ?? "",
    progress: m?.progress ?? 0,
    chars,
    char,
    l: chars.length
  };
});

function toStrokeList(strokeData: StrokeData): Array<Stroke> {
  const { strokes, radStrokes, medians } = strokeData;
  return strokes.map((item, index) => ({
    points: medians[index].map(([x, y]) => ({ x, y })),
    path: item,
    color: radStrokes?.includes(i) ? STROKE_COLOR_RADICAL : STROKE_COLOR_NORMAL
  }));
}

async function loadCharAssets(char: string): Promise<CharAssets> {
  const [detail, strokes] = await Promise.all([
    getCharInfo(char).catch((e) => {
      console.error("[char-info]", char, e);
      return null;
    }),
    loadStrokeData(char).catch((e) => {
      console.error("[stroke-data]", char, e);
      return null;
    })
  ]);
  return {
    detail,
    strokes: strokes === null ? null : toStrokeList(strokes)
  };
}

watch(
  () => info.value.char,
  async (char, _old, onCleanup) => {
    if (!char) {
      charInfo.value = null;
      strokes.value = null;
      return;
    }
    let cancelled = false;
    onCleanup(() => {
      cancelled = true;
    });

    const result = await loadCharAssets(char);
    if (cancelled) return;
    if (result) {
      if (result.detail) {
        charInfo.value = result.detail;
      }
      if (result.strokes) {
        console.log(result.strokes);
        strokes.value = result.strokes;
      }
    }
  },
  { immediate: true }
);

/** 从 OCR 结果中按页面 id 取当前素材 */
function syncMaterialFromOcr() {
  const pages = getCurrentPages();
  const currentPage = pages[pages.length - 1];
  const targetId = (currentPage?.options?.id as string) || DEFAULT_MATERIAL_ID;

  const found = ocrState.list.find((item) => item.id === targetId);
  material.value = found ?? null;
}

onShow(syncMaterialFromOcr);

function onStageChange(key: Stage) {
  if (key !== "Learn" && key !== "Write" && key !== "Recognize") return;
  stage.value = key as Stage;
}

function goBack() {
  uni.navigateBack({
    fail: () => uni.redirectTo({ url: "/pages/index/index" })
  });
}

function onFab() {}
</script>

<style scoped>
.page {
  height: 100vh;
  background-color: #ddf0de;
  display: flex;
}

.topbar {
  display: flex;
  flex-direction: row;
  align-items: center;
  height: 110rpx;
  padding: 0 28rpx;
}

.back-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background-color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(86, 130, 96, 0.12);
}

.back-hover {
  opacity: 0.7;
}

.back-arrow {
  font-size: 44rpx;
  color: #4b6b52;
  margin-top: -4rpx;
}

.topbar-info {
  flex: 1;
  padding-left: 20rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.task-name {
  font-size: 28rpx;
  color: #4b6b52;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
  width: 50vw;
}

.char-count {
  font-size: 22rpx;
  color: #8aa893;
  margin-top: 4rpx;
}

/* ===== 下一步按钮 ===== */
.fab {
  position: fixed;
  right: 34rpx;
  bottom: 56rpx;
  flex-direction: row;
  align-items: center;
  padding: 20rpx 30rpx 20rpx 34rpx;
  border-radius: 999rpx;
  background-image: linear-gradient(135deg, #ffc15e 0%, #ff8f6b 100%);
  box-shadow: 0 12rpx 28rpx rgba(255, 143, 107, 0.35);
}

.fab-off {
  opacity: 0.55;
}

.fab-label {
  font-size: 30rpx;
  color: #ffffff;
  font-weight: bold;
}

.fab-arrow {
  font-size: 40rpx;
  color: #ffffff;
  margin-left: 10rpx;
  margin-top: -2rpx;
}
</style>
