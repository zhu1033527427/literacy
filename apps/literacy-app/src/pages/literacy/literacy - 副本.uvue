<template>
	<view class="page">
		<!-- 背景装饰 -->
		<text class="deco deco-a">🍃</text>
		<text class="deco deco-b">🌿</text>
		<text class="deco deco-c">🍀</text>

		<!-- 顶部信息 -->
		<view class="topbar">
			<view class="back-btn" @click="goBack">
				<text class="back-arrow">‹</text>
			</view>
			<view class="topbar-info">
				<text class="task-name">{{ task.title }}</text>
				<text class="char-count">第 {{ currentIdx + 1 }} / {{ task.chars.length }} 个字</text>
			</view>
			<view class="steps">
				<view :class="isLearn ? 'step-dot step-on' : 'step-dot'">
					<text :class="isLearn ? 'step-text step-text-on' : 'step-text'">学</text>
				</view>
				<view :class="isWrite ? 'step-dot step-on' : 'step-dot'">
					<text :class="isWrite ? 'step-text step-text-on' : 'step-text'">写</text>
				</view>
				<view :class="isRec ? 'step-dot step-on' : 'step-dot'">
					<text :class="isRec ? 'step-text step-text-on' : 'step-text'">认</text>
				</view>
			</view>
		</view>

		<!-- ===== 学 ===== -->
		<scroll-view class="stage-scroll" direction="vertical" scroll-y="true" v-if="isLearn">
			<view class="learn-body">
				<text class="pinyin">{{ currentChar.py }}</text>
				<text class="pinyin-tip">点一点大字，跟着读一读</text>

				<view class="grid-box">
					<view class="grid-line line-v"></view>
					<view class="grid-line line-h"></view>
					<view class="grid-line line-d1"></view>
					<view class="grid-line line-d2"></view>
					<text :class="bigCharClass" @click="playAll">{{ currentChar.zi }}</text>
				</view>

				<view :class="playing ? 'audio-pill audio-on' : 'audio-pill'" @click="playAll">
					<text class="audio-icon">{{ playing ? '🔉' : '🔊' }}</text>
					<text class="audio-text">{{ audioLabel }}</text>
				</view>

				<view class="section">
					<view class="section-head">
						<text class="section-icon">🍓</text>
						<text class="section-title">词语</text>
					</view>
					<view class="word-row">
						<view :class="wordChipClasses[i]" v-for="(w, i) in words" :key="w" @click="playWord(i)">
							<text class="word-text">{{ w }}</text>
							<text class="word-sound">🔊</text>
						</view>
					</view>
				</view>

				<view class="section">
					<view class="section-head">
						<text class="section-icon">🌈</text>
						<text class="section-title">句子</text>
					</view>
					<view :class="sentenceClass" @click="playSentence">
						<text class="sentence-text">{{ sentence }}</text>
						<text class="sentence-sound">🔊</text>
					</view>
				</view>

				<view class="bottom-space"></view>
			</view>
		</scroll-view>

		<!-- ===== 写 ===== -->
		<view class="stage-write" v-else-if="isWrite">
			<view class="write-head">
				<text class="write-title">✂️ 水果描「{{ currentChar.zi }}」</text>
				<text class="write-sub">从亮亮的水果开始，一笔连续划过去</text>
			</view>

			<view class="grid-box write-box" id="write-box" @touchstart.stop="onTouchStart" @touchmove.stop="onTouchMove"
				@touchend.stop="onTouchEnd">
				<view class="grid-line line-v"></view>
				<view class="grid-line line-h"></view>
				<view class="grid-line line-d1"></view>
				<view class="grid-line line-d2"></view>

				<view v-for="g in ghosts" :key="g.id" class="ghost-seg" :style="g.style"></view>

				<view v-for="(f, i) in fruits" :key="f.id" :class="i === 0 ? 'fruit fruit-first' : 'fruit'" :style="f.style"
					@click="tapFruit(f)">
					<text class="fruit-emoji">{{ f.emoji }}</text>
				</view>

				<view class="guide" v-if="guide.visible" :style="guide.style">
					<text class="guide-emoji">🖍️</text>
				</view>

				<view v-for="s in splashes" :key="s.id" class="splash" :style="s.style">
					<text class="splash-emoji">{{ s.emoji }}</text>
				</view>

				<view class="write-done-tip" v-if="writeDone">
					<text class="write-done-emoji">🎉</text>
					<text class="write-done-text">写得真棒！</text>
				</view>
			</view>

			<view class="stroke-bar">
				<view class="stroke-dots">
					<view v-for="(c, i) in strokeDotClasses" :key="i" :class="c"></view>
				</view>
				<text class="stroke-text">{{ strokeLabel }}</text>
			</view>

			<text class="write-tip">小提示：写得慢一点，一笔一笔来～</text>
		</view>

		<!-- ===== 认 ===== -->
		<view class="stage-rec" v-else>
			<view class="rec-head">
				<text class="rec-title">{{ gameType === 'bubble' ? '🫧 戳泡泡' : '🎯 找一找' }}</text>
				<text class="rec-sub" v-if="gameType === 'bubble'">戳破写着「{{ currentChar.zi }}」的泡泡吧！</text>
				<text class="rec-sub" v-else>点一点「{{ currentChar.zi }}」的字卡吧！</text>
			</view>

			<view class="bubble-area" v-if="gameType === 'bubble'">
				<view v-for="b in options" :key="b.id" :class="wrongId === b.id ? 'bubble bubble-wrong' : 'bubble'"
					:style="b.style" @click="pickOption(b)">
					<text class="bubble-text">{{ b.zi }}</text>
				</view>
				<view v-for="s in splashes" :key="s.id" class="splash" :style="s.style">
					<text class="splash-emoji">{{ s.emoji }}</text>
				</view>
			</view>

			<view class="choice-area" v-else>
				<view v-for="b in options" :key="b.id" :class="wrongId === b.id ? 'choice-card choice-wrong' : 'choice-card'"
					@click="pickOption(b)">
					<text class="choice-py">{{ b.py }}</text>
					<text class="choice-text">{{ b.zi }}</text>
				</view>
			</view>

			<view class="rec-result" v-if="recDone">
				<text class="rec-result-emoji">🎉</text>
				<text class="rec-result-text">太棒了！就是「{{ currentChar.zi }}」</text>
			</view>
			<view class="rec-audio-row" v-else>
				<view class="rec-audio" @click="playChar">
					<text class="rec-audio-icon">🔊</text>
					<text class="rec-audio-text">再听一遍</text>
				</view>
			</view>
		</view>

		<!-- 右下角下一步 -->
		<view :class="fabOff ? 'fab fab-off' : 'fab'" @click="onFab">
			<text class="fab-label">{{ fabLabel }}</text>
			<text class="fab-arrow">›</text>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { ref, computed } from 'vue'
	import { ocrState } from '@/stores/ocr';
	import { onLoad, onShow } from '@dcloudio/uni-app'

	import { tasks } from '../../data/tasks'
	import type { Task, CharItem } from '../../data/tasks'
	import { getDetail } from '../../data/char-details'
	import type { CharDetail } from '../../data/char-details'
	import { getStrokes } from '../../data/strokes'
	import type { StrokePoint } from '../../data/strokes'

	const material = ref({});

	onShow(() => {
		const pages = getCurrentPages()
		const currentPage = pages[pages.length - 1];
		console.log(currentPage.options.id);
		if (currentPage?.options?.id) {
			const data = ocrState.list;
			material.value = data.find(item => currentPage.options.id === item.id)
		}
	})


	interface FruitItem {
		id : number
		x : number
		y : number
		emoji : string
		style : string
	}

	interface SplashItem {
		id : number
		emoji : string
		style : string
	}

	interface GhostItem {
		id : number
		style : string
	}

	interface OptionItem {
		id : number
		zi : string
		py : string
		slot : number
		style : string
	}

	const FRUITS = ['🍎', '🍓', '🍊', '🍇', '🍉', '🍑', '🍋']

	const BUBBLE_SLOTS = [
		[16, 18, 158],
		[58, 12, 140],
		[78, 42, 170],
		[12, 54, 144],
		[44, 62, 166],
		[24, 80, 136]
	]

	const BUBBLE_COLORS = [
		['#FFB3C1', '#FF7A9A'],
		['#A8D8FF', '#5FA8F5'],
		['#B9E7C9', '#6BCB9A'],
		['#FFE0A3', '#FFC15E'],
		['#D9C7FF', '#A98BF0'],
		['#C7F0EA', '#66C7BB']
	]

	const task = ref<Task>(tasks[0])
	const currentIdx = ref(0)
	const stage = ref('learn')

	const playing = ref(false)
	const activeSlot = ref(-1)
	const writeDone = ref(false)
	const recDone = ref(false)
	const wrongId = ref(0)
	const gameType = ref('bubble')

	const strokeIdx = ref(0)
	const strokes = ref<StrokePoint[][]>([])
	const ghosts = ref<GhostItem[]>([])
	const fruits = ref<FruitItem[]>([])
	const pending = ref<FruitItem[]>([])
	const guide = ref({ visible: false, style: '' })
	const splashes = ref<SplashItem[]>([])
	const options = ref<OptionItem[]>([])

	const boxRect = ref({ left: 0, top: 0, width: 0, height: 0 })

	let nextId = 1
	let strokeLock = false
	let timers : number[] = []
	let lastPt : any = null

	// ===== 音频 =====
	let audioCtx : any = null
	let queue : string[] = []
	let qIndex = 0

	function ensureAudio() : any {
		if (audioCtx === null) {
			audioCtx = uni.createInnerAudioContext()
			audioCtx.onEnded(() => {
				playNextSound()
			})
			audioCtx.onError(() => {
				playing.value = false
				activeSlot.value = -1
				queue = []
				qIndex = 0
			})
		}
		return audioCtx
	}

	function playNextSound() {
		if (qIndex >= queue.length) {
			playing.value = false
			activeSlot.value = -1
			queue = []
			qIndex = 0
			return
		}
		const src = queue[qIndex]
		activeSlot.value = qIndex
		qIndex++
		if (audioCtx !== null) {
			audioCtx.src = src
			audioCtx.play()
		}
	}

	function playSeq(paths : string[]) {
		stopAudio()
		if (paths.length === 0) {
			return
		}
		const ctx = ensureAudio()
		queue = paths
		playing.value = true
		activeSlot.value = 0
		qIndex = 1
		ctx.src = paths[0]
		ctx.play()
	}

	function stopAudio() {
		queue = []
		qIndex = 0
		playing.value = false
		activeSlot.value = -1
		if (audioCtx !== null) {
			audioCtx.stop()
		}
	}

	// 朗读音频：使用在线语音接口，避免把小语料打进小程序包
	function audioText(slot : number) : string {
		if (slot === 0) {
			return currentChar.value.zi
		}
		const ws = words.value
		if (slot <= ws.length) {
			return ws[slot - 1]
		}
		return sentence.value
	}

	function audioUrl(slot : number) : string {
		return 'https://fanyi.baidu.com/gettts?lan=zh&spd=3&source=web&text=' + encodeURIComponent(audioText(slot))
	}

	function playAll() {
		const list : string[] = []
		list.push(audioUrl(0))
		const ws = words.value
		for (let i = 0; i < ws.length; i++) {
			list.push(audioUrl(i + 1))
		}
		list.push(audioUrl(ws.length + 1))
		playSeq(list)
	}

	function playChar() {
		playSeq([audioUrl(0)])
		activeSlot.value = 0
	}

	function playWord(i : number) {
		playSeq([audioUrl(i + 1)])
		activeSlot.value = i + 1
	}

	function playSentence() {
		playSeq([audioUrl(words.value.length + 1)])
		activeSlot.value = words.value.length + 1
	}

	// ===== 数据 =====
	const currentChar = computed(() : CharItem => {
		const list = task.value.chars
		if (list.length === 0) {
			return { zi: '字', py: 'zì' }
		}
		const i = Math.min(currentIdx.value, list.length - 1)
		return list[i]
	})

	const detail = computed(() : CharDetail => {
		return getDetail(currentChar.value.zi)
	})

	const words = computed(() : string[] => {
		return detail.value.words
	})

	const sentence = computed(() : string => {
		return detail.value.sentence
	})

	// 朗读到哪一项就高亮哪一项
	const audioLabel = computed(() : string => {
		if (!playing.value || activeSlot.value < 0) {
			return '听一听：字 · 词 · 句'
		}
		return '正在读：' + audioText(activeSlot.value)
	})

	const bigCharClass = computed(() : string => {
		if (playing.value && activeSlot.value === 0) {
			return 'big-char big-char-on'
		}
		return 'big-char'
	})

	const wordChipClasses = computed(() : string[] => {
		const list : string[] = []
		const ws = words.value
		for (let i = 0; i < ws.length; i++) {
			if (playing.value && activeSlot.value === i + 1) {
				list.push('word-chip word-chip-on')
			} else {
				list.push('word-chip')
			}
		}
		return list
	})

	const sentenceClass = computed(() : string => {
		if (playing.value && activeSlot.value === words.value.length + 1) {
			return 'sentence-card sentence-card-on'
		}
		return 'sentence-card'
	})

	const isLearn = computed(() : boolean => {
		return stage.value === 'learn'
	})

	const isWrite = computed(() : boolean => {
		return stage.value === 'write'
	})

	const isRec = computed(() : boolean => {
		return stage.value === 'recognize'
	})

	const isLast = computed(() : boolean => {
		return currentIdx.value >= task.value.chars.length - 1
	})

	const fabLabel = computed(() : string => {
		if (stage.value === 'learn') {
			return '下一步 · 写'
		}
		if (stage.value === 'write') {
			return writeDone.value ? '下一步 · 认' : '继续写 ✋'
		}
		if (recDone.value) {
			return isLast.value ? '完成 🎉' : '下一个字 ›'
		}
		return '找到它吧 👀'
	})

	const fabOff = computed(() : boolean => {
		if (stage.value === 'write') {
			return !writeDone.value
		}
		if (stage.value === 'recognize') {
			return !recDone.value
		}
		return false
	})

	const strokeLabel = computed(() : string => {
		if (writeDone.value) {
			return '全部写完啦'
		}
		const total = strokes.value.length
		const now = Math.min(strokeIdx.value + 1, total)
		return '第 ' + now + ' 笔 / 共 ' + total + ' 笔'
	})

	const strokeDotClasses = computed(() : string[] => {
		const list : string[] = []
		for (let i = 0; i < strokes.value.length; i++) {
			if (writeDone.value || i < strokeIdx.value) {
				list.push('stroke-dot stroke-dot-done')
			} else if (i === strokeIdx.value) {
				list.push('stroke-dot stroke-dot-on')
			} else {
				list.push('stroke-dot')
			}
		}
		return list
	})

	// ===== 样式工具 =====
	function centerStyle(xPct : number, yPct : number, size : number, opacity : number) : string {
		return 'left:' + xPct + '%; top:' + yPct + '%; width:' + size + 'rpx; height:' + size + 'rpx; margin-left:' + (-size / 2) + 'rpx; margin-top:' + (-size / 2) + 'rpx; opacity:' + opacity + ';'
	}

	function fruitStyleString(x : number, y : number) : string {
		return centerStyle(x / 10, y / 10, 46, 1)
	}

	function splashStyleString(xPct : number, yPct : number, frame : number) : string {
		const sizes = [34, 48, 64, 80]
		const opacities = [1, 0.85, 0.6, 0.2]
		return centerStyle(xPct, yPct, sizes[frame], opacities[frame])
	}

	function bubbleStyleString(i : number) : string {
		const slot = BUBBLE_SLOTS[i % BUBBLE_SLOTS.length]
		const colors = BUBBLE_COLORS[i % BUBBLE_COLORS.length]
		const size = slot[2]
		return 'left:' + slot[0] + '%; top:' + slot[1] + '%; width:' + size + 'rpx; height:' + size + 'rpx; margin-left:' + (-size / 2) + 'rpx; margin-top:' + (-size / 2) + 'rpx; background-image: linear-gradient(135deg, ' + colors[0] + ' 0%, ' + colors[1] + ' 100%);'
	}

	function spawnSplash(xPct : number, yPct : number, emoji : string) {
		const id = nextId++
		const item : SplashItem = { id: id, emoji: emoji, style: splashStyleString(xPct, yPct, 0) }
		splashes.value = splashes.value.concat([item])
		for (let f = 1; f <= 3; f++) {
			const frame = f
			later(() => {
				splashes.value = splashes.value.map((s) => {
					if (s.id === id) {
						return { id: s.id, emoji: s.emoji, style: splashStyleString(xPct, yPct, frame) }
					}
					return s
				})
			}, 80 * frame)
		}
		later(() => {
			splashes.value = splashes.value.filter((s) => s.id !== id)
		}, 380)
	}

	// ===== 计时器 =====
	function later(fn : () => void, ms : number) {
		const id = setTimeout(fn, ms) as any
		timers.push(id)
	}

	function clearTimers() {
		for (let i = 0; i < timers.length; i++) {
			clearTimeout(timers[i])
		}
		timers = []
	}

	// ===== 生命周期 =====
	onLoad((query : any) => {
		const id = query && query.id ? parseInt(query.id) : 0
		const ci = query && query.ci ? parseInt(query.ci) : 0
		const found = tasks.find((b) => b.id === id)
		if (found) {
			task.value = found
			currentIdx.value = Math.min(Math.max(ci, 0), found.chars.length - 1)
		}
		loadChar()
	})

	onUnload(() => {
		clearTimers()
		stopAudio()
		if (audioCtx !== null) {
			audioCtx.destroy()
			audioCtx = null
		}
	})

	function loadChar() {
		clearTimers()
		stopAudio()
		strokeLock = false
		stage.value = 'learn'
		writeDone.value = false
		recDone.value = false
		wrongId.value = 0
		strokeIdx.value = 0
		fruits.value = []
		pending.value = []
		guide.value = { visible: false, style: '' }
		splashes.value = []
		options.value = []
		ghosts.value = []
		strokes.value = getStrokes(currentChar.value.zi)
		later(() => {
			playAll()
		}, 600)
	}

	function goBack() {
		uni.navigateBack()
	}

	// ===== 学 → 写 =====
	function enterWrite() {
		clearTimers()
		stopAudio()
		strokeLock = false
		stage.value = 'write'
		writeDone.value = false
		strokeIdx.value = 0
		fruits.value = []
		pending.value = []
		guide.value = { visible: false, style: '' }
		splashes.value = []
		strokes.value = getStrokes(currentChar.value.zi)
		buildGhost()
		if (strokes.value.length === 0) {
			writeDone.value = true
			return
		}
		buildFruits(strokes.value[0])
		later(() => {
			measureBox()
		}, 300)
	}

	function measureBox() {
		uni.createSelectorQuery().select('#write-box').boundingClientRect((rect : any) => {
			if (rect) {
				boxRect.value = { left: rect.left, top: rect.top, width: rect.width, height: rect.height }
			}
		}).exec()
	}

	// ===== 背景描红 =====
	// 用同一份笔画中轴线画浅色底字，水果轨迹与底字天然重合
	function buildGhost() {
		const list : GhostItem[] = []
		const all = strokes.value
		for (let si = 0; si < all.length; si++) {
			const s = all[si]
			if (s.length === 0) {
				continue
			}
			if (s.length === 1) {
				list.push({ id: nextId++, style: ghostSegStyle(s[0][0], s[0][1], s[0][0] + 2, s[0][1] + 2) })
				continue
			}
			for (let i = 0; i < s.length - 1; i++) {
				list.push({ id: nextId++, style: ghostSegStyle(s[i][0], s[i][1], s[i + 1][0], s[i + 1][1]) })
			}
		}
		ghosts.value = list
	}

	function ghostSegStyle(x1 : number, y1 : number, x2 : number, y2 : number) : string {
		const mx = (x1 + x2) / 2
		const my = (y1 + y2) / 2
		const dx = x2 - x1
		const dy = y2 - y1
		const dist = Math.sqrt(dx * dx + dy * dy)
		const thick = 26
		let len = dist / 1000 * 582 + thick
		if (len < thick) {
			len = thick
		}
		const angle = Math.atan2(dy, dx) * 180 / Math.PI
		let style = 'left:' + (mx / 10) + '%; top:' + (my / 10) + '%; width:' + len + 'rpx; height:' + thick + 'rpx; margin-left:' + (-len / 2) + 'rpx; margin-top:' + (-thick / 2) + 'rpx; border-radius:' + (thick / 2) + 'rpx; background-color:#AFCBB4; opacity:0.45;'
		if (dist > 6) {
			style = style + ' transform: rotate(' + angle + 'deg);'
		}
		return style
	}

	// ===== 笔画水果 =====
	function samplePoints(stroke : StrokePoint[]) : StrokePoint[] {
		const dense : StrokePoint[] = []
		for (let i = 0; i < stroke.length - 1; i++) {
			const a = stroke[i]
			const b = stroke[i + 1]
			const dx = b[0] - a[0]
			const dy = b[1] - a[1]
			const len = Math.sqrt(dx * dx + dy * dy)
			const steps = Math.max(1, Math.ceil(len / 18))
			for (let s = 0; s < steps; s++) {
				dense.push([a[0] + dx * s / steps, a[1] + dy * s / steps])
			}
		}
		if (stroke.length > 0) {
			dense.push(stroke[stroke.length - 1])
		}
		return dense
	}

	function buildFruits(stroke : StrokePoint[]) {
		const dense = samplePoints(stroke)
		if (dense.length === 0) {
			writeDone.value = true
			return
		}
		const segLens : number[] = []
		let total = 0
		for (let i = 1; i < dense.length; i++) {
			const dx = dense[i][0] - dense[i - 1][0]
			const dy = dense[i][1] - dense[i - 1][1]
			const l = Math.sqrt(dx * dx + dy * dy)
			segLens.push(l)
			total = total + l
		}
		const count = Math.min(20, Math.max(5, Math.round(total / 80)))
		const list : FruitItem[] = []
		if (segLens.length === 0 || total < 60) {
			// 点、提这类很短的笔画：围成一小簇水果
			const base = dense[0]
			const offsets = [[-18, 10], [0, -16], [18, 10]]
			for (let k = 0; k < 3; k++) {
				const px = base[0] + offsets[k][0]
				const py = base[1] + offsets[k][1]
				list.push({
					id: nextId++,
					x: px,
					y: py,
					emoji: FRUITS[k % FRUITS.length],
					style: fruitStyleString(px, py)
				})
			}
			startReveal(list)
			return
		}
		for (let k = 0; k < count; k++) {
			const target = count === 1 ? 0 : total * k / (count - 1)
			let acc = 0
			let px = dense[dense.length - 1][0]
			let py = dense[dense.length - 1][1]
			for (let i = 0; i < segLens.length; i++) {
				const seg = segLens[i]
				if (acc + seg >= target) {
					const t = seg === 0 ? 0 : (target - acc) / seg
					const a = dense[i]
					const b = dense[i + 1]
					px = a[0] + (b[0] - a[0]) * t
					py = a[1] + (b[1] - a[1]) * t
					break
				}
				acc = acc + seg
			}
			list.push({
				id: nextId++,
				x: px,
				y: py,
				emoji: FRUITS[k % FRUITS.length],
				style: fruitStyleString(px, py)
			})
		}
		startReveal(list)
	}

	// 铅笔尖沿笔画中轴线往前走，水果跟着一个个长出来
	function startReveal(list : FruitItem[]) {
		fruits.value = []
		pending.value = list
		if (list.length === 0) {
			guide.value = { visible: false, style: '' }
			writeDone.value = true
			return
		}
		guide.value = { visible: true, style: guideStyleString(list[0]) }
		later(() => {
			revealStep()
		}, 120)
	}

	function revealStep() {
		if (pending.value.length === 0) {
			return
		}
		const next = pending.value[0]
		pending.value = pending.value.slice(1)
		fruits.value = fruits.value.concat([next])
		if (pending.value.length === 0) {
			later(() => {
				guide.value = { visible: false, style: guide.value.style }
			}, 260)
			return
		}
		guide.value = { visible: true, style: guideStyleString(pending.value[0]) }
		later(() => {
			revealStep()
		}, 60)
	}

	function guideStyleString(f : FruitItem) : string {
		return centerStyle(f.x / 10, f.y / 10 - 6, 52, 0.9)
	}

	function touchPoint(e : any) : any {
		const touches = e.touches
		if (!touches || touches.length === 0) {
			return null
		}
		const t = touches[0]
		let cx = 0
		let cy = 0
		if (t.clientX !== undefined) {
			cx = t.clientX
			cy = t.clientY
		} else if (t.pageX !== undefined) {
			cx = t.pageX
			cy = t.pageY
		} else if (t.x !== undefined) {
			cx = t.x
			cy = t.y
		}
		const r = boxRect.value
		if (r.width <= 0 || r.height <= 0) {
			return null
		}
		return {
			x: (cx - r.left) / r.width * 1000,
			y: (cy - r.top) / r.height * 1000
		}
	}

	function onTouchStart(e : any) {
		lastPt = null
		if (boxRect.value.width <= 0) {
			measureBox()
		}
		handleCut(e)
	}

	function onTouchMove(e : any) {
		handleCut(e)
	}

	function onTouchEnd() {
		lastPt = null
	}

	// 点到线段的距离：手指从上一帧滑到这一帧，扫过的水果都算切开
	function segDistance(px : number, py : number, ax : number, ay : number, bx : number, by : number) : number {
		const dx = bx - ax
		const dy = by - ay
		const len2 = dx * dx + dy * dy
		if (len2 <= 0) {
			return Math.sqrt((px - ax) * (px - ax) + (py - ay) * (py - ay))
		}
		let t = ((px - ax) * dx + (py - ay) * dy) / len2
		if (t < 0) {
			t = 0
		}
		if (t > 1) {
			t = 1
		}
		const cx = ax + dx * t
		const cy = ay + dy * t
		return Math.sqrt((px - cx) * (px - cx) + (py - cy) * (py - cy))
	}

	function handleCut(e : any) {
		if (stage.value !== 'write' || writeDone.value || strokeLock) {
			return
		}
		const p = touchPoint(e)
		if (p === null) {
			return
		}
		const from = lastPt === null ? p : lastPt
		const left : FruitItem[] = []
		let cutCount = 0
		for (let i = 0; i < fruits.value.length; i++) {
			const f = fruits.value[i]
			const d = segDistance(f.x, f.y, from.x, from.y, p.x, p.y)
			if (d <= 76) {
				spawnSplash(f.x / 10, f.y / 10, '💥')
				spawnSplash(f.x / 10 + 3, f.y / 10 - 4, '💧')
				cutCount++
			} else {
				left.push(f)
			}
		}
		lastPt = { x: p.x, y: p.y }
		if (cutCount > 0) {
			fruits.value = left
		}
		if (fruits.value.length === 0 && pending.value.length === 0) {
			completeStroke()
		}
	}

	// 点按水果也可以切（拖不动时的小兜底）
	function tapFruit(f : FruitItem) {
		if (stage.value !== 'write' || writeDone.value || strokeLock) {
			return
		}
		let exists = false
		for (let i = 0; i < fruits.value.length; i++) {
			if (fruits.value[i].id === f.id) {
				exists = true
			}
		}
		if (!exists) {
			return
		}
		fruits.value = fruits.value.filter((x) => x.id !== f.id)
		spawnSplash(f.x / 10, f.y / 10, '💥')
		spawnSplash(f.x / 10 + 3, f.y / 10 - 4, '💧')
		if (fruits.value.length === 0 && pending.value.length === 0) {
			completeStroke()
		}
	}

	function completeStroke() {
		if (strokeLock) {
			return
		}
		strokeLock = true
		lastPt = null
		later(() => {
			strokeIdx.value = strokeIdx.value + 1
			if (strokeIdx.value >= strokes.value.length) {
				writeDone.value = true
				strokeLock = false
				uni.showToast({ title: '写得真棒！', icon: 'none' })
				return
			}
			buildFruits(strokes.value[strokeIdx.value])
			strokeLock = false
		}, 450)
	}

	// ===== 写 → 认 =====
	function enterRecognize() {
		clearTimers()
		stopAudio()
		stage.value = 'recognize'
		recDone.value = false
		wrongId.value = 0
		gameType.value = Math.random() < 0.5 ? 'bubble' : 'choice'
		buildOptions()
		later(() => {
			playChar()
		}, 400)
	}

	function shuffleAny(list : any[]) {
		for (let i = list.length - 1; i > 0; i--) {
			const j = Math.floor(Math.random() * (i + 1))
			const tmp = list[i]
			list[i] = list[j]
			list[j] = tmp
		}
	}

	function buildOptions() {
		const correct = currentChar.value
		const seen : string[] = [correct.zi]
		const pool : CharItem[] = []
		for (let bi = 0; bi < tasks.length; bi++) {
			const b = tasks[bi]
			for (let ci = 0; ci < b.chars.length; ci++) {
				const c = b.chars[ci]
				if (seen.indexOf(c.zi) < 0) {
					seen.push(c.zi)
					pool.push(c)
				}
			}
		}
		shuffleAny(pool)
		const picks : CharItem[] = []
		for (let i = 0; i < pool.length && picks.length < 3; i++) {
			picks.push(pool[i])
		}
		const list : OptionItem[] = []
		list.push({ id: 0, zi: correct.zi, py: correct.py, slot: 0, style: '' })
		for (let i = 0; i < picks.length; i++) {
			list.push({ id: 0, zi: picks[i].zi, py: picks[i].py, slot: 0, style: '' })
		}
		shuffleAny(list)
		for (let i = 0; i < list.length; i++) {
			const o = list[i]
			o.id = i + 1
			o.slot = i
			if (gameType.value === 'bubble') {
				o.style = bubbleStyleString(i)
			}
		}
		options.value = list
	}

	function pickOption(b : OptionItem) {
		if (recDone.value) {
			return
		}
		if (b.zi === currentChar.value.zi) {
			recDone.value = true
			stopAudio()
			if (gameType.value === 'bubble') {
				const slot = BUBBLE_SLOTS[b.slot % BUBBLE_SLOTS.length]
				spawnSplash(slot[0], slot[1], '🎉')
				spawnSplash(slot[0] + 6, slot[1] - 5, '✨')
			}
			uni.showToast({ title: '太棒了！', icon: 'none' })
			return
		}
		wrongId.value = b.id
		later(() => {
			wrongId.value = 0
		}, 700)
		uni.showToast({ title: '再想一想～', icon: 'none' })
	}

	// ===== 流程控制 =====
	function onFab() {
		if (stage.value === 'learn') {
			enterWrite()
			return
		}
		if (stage.value === 'write') {
			if (!writeDone.value) {
				uni.showToast({ title: '先把水果都切完哦～', icon: 'none' })
				return
			}
			enterRecognize()
			return
		}
		if (!recDone.value) {
			uni.showToast({ title: '先找到正确的字吧～', icon: 'none' })
			return
		}
		nextChar()
	}

	function nextChar() {
		if (currentIdx.value + 1 < task.value.chars.length) {
			currentIdx.value = currentIdx.value + 1
			loadChar()
			return
		}
		uni.showToast({ title: '这本绘本的字都学完啦！', icon: 'none' })
		setTimeout(() => {
			uni.navigateBack()
		}, 900)
	}

	// function playAudio() {
	// 	// 优先播预生成音频
	// 	if (currentChar.value.audioUrl) {
	// 		const audio = uni.createInnerAudioContext()
	// 		audio.src = currentChar.value.audioUrl
	// 		audio.play()
	// 	} else {
	// 		// 兜底：端侧TTS（微信小程序）
	// 		// #ifdef MP-WEIXIN
	// 		wx.getPluginManager().get('WechatSI').textToSpeech({
	// 			lang: 'zh_CN',
	// 			content: currentChar.value.char,
	// 			success: (res) => {
	// 				const audio = uni.createInnerAudioContext()
	// 				audio.src = res.filename
	// 				audio.play()
	// 			}
	// 		})
	// 		// #endif
	// 	}
	// }
</script>

<style>
	.page {
		height: 100vh;
		background-color: #DDF0DE;
		padding-bottom: 0;
		position: relative;
	}

	/* ===== 背景装饰 ===== */
	.deco {
		position: absolute;
		opacity: 0.35;
	}

	.deco-a {
		top: 120rpx;
		left: 24rpx;
		font-size: 44rpx;
	}

	.deco-b {
		top: 210rpx;
		right: 18rpx;
		font-size: 40rpx;
	}

	.deco-c {
		top: 60rpx;
		right: 120rpx;
		font-size: 30rpx;
	}

	/* ===== 顶部 ===== */
	.topbar {
		flex-direction: row;
		align-items: center;
		height: 110rpx;
		padding: 0 28rpx;
	}

	.back-btn {
		width: 64rpx;
		height: 64rpx;
		border-radius: 50%;
		background-color: #FFFFFF;
		align-items: center;
		justify-content: center;
		box-shadow: 0 4rpx 12rpx rgba(86, 130, 96, 0.12);
	}

	.back-arrow {
		font-size: 44rpx;
		color: #4B6B52;
		margin-top: -4rpx;
	}

	.topbar-info {
		flex: 1;
		padding-left: 20rpx;
	}

	.task-name {
		font-size: 28rpx;
		color: #4B6B52;
	}

	.char-count {
		font-size: 22rpx;
		color: #8AA893;
		margin-top: 4rpx;
	}

	.steps {
		flex-direction: row;
		align-items: center;
	}

	.step-dot {
		width: 52rpx;
		height: 52rpx;
		border-radius: 50%;
		background-color: #F2F9F1;
		border-width: 2rpx;
		border-style: solid;
		border-color: #C9DFCB;
		align-items: center;
		justify-content: center;
		margin-left: 12rpx;
	}

	.step-on {
		background-image: linear-gradient(135deg, #FFC15E 0%, #FF9A6B 100%);
		border-color: #FFB74D;
	}

	.step-text {
		font-size: 24rpx;
		color: #8AA893;
	}

	.step-text-on {
		color: #FFFFFF;
		font-weight: bold;
	}

	/* ===== 学 ===== */
	.stage-scroll {
		flex: 1;
	}

	.learn-body {
		align-items: center;
		padding: 6rpx 34rpx 0;
	}

	.pinyin {
		font-size: 40rpx;
		color: #7B9E84;
		font-weight: bold;
	}

	.pinyin-tip {
		font-size: 22rpx;
		color: #9DB9A4;
		margin-top: 6rpx;
	}

	.grid-box {
		width: 560rpx;
		height: 560rpx;
		background-color: #FBFDF7;
		border-width: 4rpx;
		border-style: solid;
		border-color: #B9D6BC;
		border-radius: 18rpx;
		margin-top: 18rpx;
		align-items: center;
		justify-content: center;
		box-shadow: 0 10rpx 26rpx rgba(86, 130, 96, 0.12);
		position: relative;
	}

	.grid-line {
		position: absolute;
		background-color: #AFCCB2;
		opacity: 0.55;
	}

	.line-v {
		left: 50%;
		top: 6rpx;
		width: 2rpx;
		height: 548rpx;
		margin-left: -1rpx;
	}

	.line-h {
		top: 50%;
		left: 6rpx;
		height: 2rpx;
		width: 548rpx;
		margin-top: -1rpx;
	}

	.line-d1 {
		top: 50%;
		left: 50%;
		width: 740rpx;
		height: 2rpx;
		margin-left: -370rpx;
		margin-top: -1rpx;
		transform: rotate(45deg);
	}

	.line-d2 {
		top: 50%;
		left: 50%;
		width: 740rpx;
		height: 2rpx;
		margin-left: -370rpx;
		margin-top: -1rpx;
		transform: rotate(-45deg);
	}

	.big-char {
		font-size: 380rpx;
		line-height: 380rpx;
		color: #35543F;
		font-weight: bold;
	}

	.big-char-on {
		color: #E06A4D;
	}

	.audio-pill {
		flex-direction: row;
		align-items: center;
		margin-top: 24rpx;
		padding: 16rpx 30rpx;
		border-radius: 999rpx;
		background-color: #FFFFFF;
		border-width: 3rpx;
		border-style: solid;
		border-color: #BFE3C6;
		box-shadow: 0 6rpx 16rpx rgba(86, 130, 96, 0.1);
	}

	.audio-on {
		background-image: linear-gradient(135deg, #D9F5E1 0%, #BEEBD0 100%);
		border-color: #7BCFA3;
	}

	.audio-icon {
		font-size: 32rpx;
		margin-right: 12rpx;
	}

	.audio-text {
		font-size: 26rpx;
		color: #3F6B52;
		font-weight: bold;
	}

	.section {
		width: 100%;
		margin-top: 32rpx;
	}

	.section-head {
		flex-direction: row;
		align-items: center;
	}

	.section-icon {
		font-size: 30rpx;
		margin-right: 10rpx;
	}

	.section-title {
		font-size: 28rpx;
		color: #4B6B52;
		font-weight: bold;
	}

	.word-row {
		flex-direction: row;
		flex-wrap: wrap;
		margin-top: 14rpx;
	}

	.word-chip {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		border-radius: 999rpx;
		padding: 14rpx 24rpx;
		margin-right: 16rpx;
		margin-bottom: 14rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #D3E8D4;
	}

	.word-chip-on {
		background-color: #FFE3B8;
		border-color: #FFB74D;
	}

	.word-text {
		font-size: 30rpx;
		color: #35543F;
		font-weight: bold;
	}

	.word-sound {
		font-size: 22rpx;
		margin-left: 8rpx;
	}

	.sentence-card {
		flex-direction: row;
		align-items: center;
		background-color: #FFFFFF;
		border-radius: 24rpx;
		padding: 24rpx 26rpx;
		margin-top: 14rpx;
		border-width: 2rpx;
		border-style: solid;
		border-color: #D3E8D4;
		box-shadow: 0 6rpx 16rpx rgba(86, 130, 96, 0.08);
	}

	.sentence-card-on {
		background-color: #FFF3D9;
		border-color: #FFC15E;
	}

	.sentence-text {
		flex: 1;
		font-size: 28rpx;
		color: #4A5F4E;
		line-height: 46rpx;
	}

	.sentence-sound {
		font-size: 30rpx;
		margin-left: 12rpx;
	}

	.bottom-space {
		height: 190rpx;
	}

	/* ===== 写 ===== */
	.stage-write {
		flex: 1;
		align-items: center;
		padding: 10rpx 30rpx 0;
	}

	.write-head {
		align-items: center;
	}

	.write-title {
		font-size: 34rpx;
		color: #3F6B52;
		font-weight: bold;
	}

	.write-sub {
		font-size: 22rpx;
		color: #8AA893;
		margin-top: 8rpx;
	}

	.write-box {
		width: 590rpx;
		height: 590rpx;
		margin-top: 22rpx;
	}

	.ghost-seg {
		position: absolute;
	}

	.fruit {
		position: absolute;
		align-items: center;
		justify-content: center;
	}

	.fruit-first {
		border-radius: 50%;
		background-color: #FFFFFF;
		border-width: 3rpx;
		border-style: solid;
		border-color: #FFB74D;
		box-shadow: 0 0 0 8rpx rgba(255, 183, 77, 0.18);
	}

	.fruit-emoji {
		font-size: 36rpx;
	}

	.guide {
		position: absolute;
		align-items: center;
		justify-content: center;
	}

	.guide-emoji {
		font-size: 40rpx;
	}

	.splash {
		position: absolute;
		align-items: center;
		justify-content: center;
	}

	.splash-emoji {
		font-size: 38rpx;
	}

	.write-done-tip {
		position: absolute;
		top: 200rpx;
		left: 0;
		width: 590rpx;
		align-items: center;
	}

	.write-done-emoji {
		font-size: 110rpx;
	}

	.write-done-text {
		font-size: 34rpx;
		color: #3F6B52;
		font-weight: bold;
		margin-top: 8rpx;
	}

	.stroke-bar {
		width: 100%;
		margin-top: 26rpx;
		align-items: center;
	}

	.stroke-dots {
		flex-direction: row;
		flex-wrap: wrap;
		justify-content: center;
	}

	.stroke-dot {
		width: 20rpx;
		height: 20rpx;
		border-radius: 50%;
		background-color: #C9DFCB;
		margin: 0 6rpx;
	}

	.stroke-dot-on {
		background-color: #FFB74D;
	}

	.stroke-dot-done {
		background-color: #7BCFA3;
	}

	.stroke-text {
		font-size: 24rpx;
		color: #6E8F76;
		margin-top: 14rpx;
	}

	.write-tip {
		font-size: 22rpx;
		color: #9DB9A4;
		margin-top: 18rpx;
	}

	/* ===== 认 ===== */
	.stage-rec {
		flex: 1;
		align-items: center;
		padding: 16rpx 30rpx 0;
	}

	.rec-head {
		align-items: center;
	}

	.rec-title {
		font-size: 34rpx;
		color: #3F6B52;
		font-weight: bold;
	}

	.rec-sub {
		font-size: 24rpx;
		color: #8AA893;
		margin-top: 8rpx;
	}

	.bubble-area {
