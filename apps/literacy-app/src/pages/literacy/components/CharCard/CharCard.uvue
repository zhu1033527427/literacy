<template>
	<view class="char-card">
		<!-- 主字区域 -->
		<view class="main-area" @click="readAll">
			<text class="char">{{ explain.char }}</text>
			<text class="pinyin">{{ explain.pinyin }}</text>
		</view>

		<!-- 讲解信息 -->
		<view class="info-section">
			<!-- 基本信息 -->
			<view class="basic-info">
				<view class="info-item">
					<text class="info-label">部首</text>
					<text class="info-value">{{ explain.radical }}</text>
				</view>
				<view class="info-item">
					<text class="info-label">笔画</text>
					<text class="info-value">{{ explain.strokes }}画</text>
				</view>
				<view class="info-item">
					<text class="info-label">结构</text>
					<text class="info-value">{{ explain.structure }}</text>
				</view>
			</view>

			<!-- 笔顺 -->
			<view class="section" v-if="explain.order.length > 0">
				<text class="section-title">笔顺</text>
				<view class="order-list">
					<view class="order-item" v-for="(item, index) in explain.order" :key="index">
						<text class="order-num">{{ index + 1 }}</text>
						<text class="order-text">{{ item }}</text>
					</view>
				</view>
			</view>

			<!-- 释义 -->
			<view class="section" v-if="explain.meaning">
				<text class="section-title">释义</text>
				<text class="section-content">{{ explain.meaning }}</text>
			</view>

			<!-- 字源 -->
			<view class="section" v-if="explain.origin">
				<text class="section-title">字源</text>
				<text class="section-content">{{ explain.origin }}</text>
			</view>

			<!-- 记忆小贴士 -->
			<view class="section tip" v-if="explain.tip">
				<text class="section-title">💡 小贴士</text>
				<text class="section-content">{{ explain.tip }}</text>
			</view>

			<!-- 组词 -->
			<view class="section" v-if="explain.words.length > 0">
				<text class="section-title">组词</text>
				<view class="words-list">
					<view class="word-tag" v-for="(word, index) in explain.words" :key="index" @click.stop="readWord(word)">
						<text>{{ word }}</text>
					</view>
				</view>
			</view>

			<!-- 造句 -->
			<view class="section" v-if="explain.sentences.length > 0">
				<text class="section-title">造句</text>
				<view class="sentence-item" v-for="(sentence, index) in explain.sentences" :key="index"
					@click.stop="readSentence(sentence)">
					<text class="sentence-index">{{ index + 1 }}.</text>
					<text class="sentence-text">{{ sentence }}</text>
				</view>
			</view>
		</view>

		<!-- 朗读按钮 -->
		<view class="read-all-btn" @click="readAll">
			<text class="btn-icon">🔊</text>
			<text class="btn-text">{{ isReading ? '朗读中...' : '完整朗读' }}</text>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { ref, watch } from 'vue'
	import { getCharExplain } from '@/utils/charExplain'
	import { speak, speakSequence } from '@/utils/tts'

	const props = defineProps<{
		char : string
	}>()

	const explain = ref(getCharExplain(''))
	const isReading = ref(false)

	// 监听汉字变化
	watch(() => props.char, (newChar) => {
		if (newChar) {
			explain.value = getCharExplain(newChar)
		}
	}, { immediate: true })

	// 完整朗读
	async function readAll() {
		if (isReading.value) return
		isReading.value = true

		try {
			const texts = [
				explain.value.char,
				explain.value.pinyin,
				...explain.value.words,
				...explain.value.sentences
			]
			await speakSequence(texts)
		} catch (err) {
			console.error('朗读失败', err)
		} finally {
			isReading.value = false
		}
	}

	// 朗读词语
	async function readWord(word : string) {
		if (isReading.value) return
		isReading.value = true
		try {
			await speak({ text: word })
		} finally {
			isReading.value = false
		}
	}

	// 朗读句子
	async function readSentence(sentence : string) {
		if (isReading.value) return
		isReading.value = true
		try {
			await speak({ text: sentence })
		} finally {
			isReading.value = false
		}
	}
</script>

<style scoped>
	.char-card {
		background: #fff;
		border-radius: 24rpx;
		overflow: hidden;
		box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
	}

	/* 主字区域 */
	.main-area {
		display: flex;
		flex-direction: column;
		align-items: center;
		padding: 60rpx 40rpx;
		background: linear-gradient(135deg, #F5F9F4, #EDF5EA);
		cursor: pointer;
	}

	.char {
		font-size: 160rpx;
		color: #333;
		font-weight: bold;
		line-height: 1.2;
	}

	.pinyin {
		font-size: 42rpx;
		color: #4B6B52;
		margin-top: 16rpx;
		font-weight: 500;
	}

	/* 讲解区域 */
	.info-section {
		padding: 32rpx;
	}

	.basic-info {
		display: flex;
		justify-content: space-around;
		padding: 20rpx;
		background: #F8FAF7;
		border-radius: 16rpx;
		margin-bottom: 24rpx;
	}

	.info-item {
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.info-label {
		font-size: 22rpx;
		color: #999;
		margin-bottom: 8rpx;
	}

	.info-value {
		font-size: 32rpx;
		color: #333;
		font-weight: bold;
	}

	/* 通用区块 */
	.section {
		margin-bottom: 24rpx;
	}

	.section-title {
		font-size: 26rpx;
		color: #666;
		font-weight: bold;
		margin-bottom: 12rpx;
		display: block;
	}

	.section-content {
		font-size: 28rpx;
		color: #333;
		line-height: 1.8;
	}

	/* 笔顺 */
	.order-list {
		display: flex;
		flex-wrap: wrap;
		gap: 12rpx;
	}

	.order-item {
		display: flex;
		align-items: center;
		padding: 6rpx 16rpx;
		background: #F0F9EB;
		border-radius: 8rpx;
	}

	.order-num {
		font-size: 20rpx;
		color: #8AA893;
		margin-right: 6rpx;
	}

	.order-text {
		font-size: 26rpx;
		color: #4B6B52;
	}

	/* 小贴士 */
	.tip {
		padding: 16rpx;
		background: #FFF8E1;
		border-radius: 12rpx;
	}

	/* 组词 */
	.words-list {
		display: flex;
		flex-wrap: wrap;
		gap: 16rpx;
	}

	.word-tag {
		padding: 8rpx 24rpx;
		background: #E8F4FD;
		border-radius: 20rpx;
		font-size: 28rpx;
		color: #2B6CB0;
		cursor: pointer;
	}

	.word-tag:active {
		opacity: 0.7;
	}

	/* 造句 */
	.sentence-item {
		padding: 12rpx 0;
		border-bottom: 1rpx solid #F0F0F0;
		cursor: pointer;
	}

	.sentence-item:last-child {
		border-bottom: none;
	}

	.sentence-index {
		font-size: 24rpx;
		color: #999;
		margin-right: 8rpx;
	}

	.sentence-text {
		font-size: 28rpx;
		color: #333;
		line-height: 1.6;
	}

	/* 朗读按钮 */
	.read-all-btn {
		display: flex;
		align-items: center;
		justify-content: center;
		padding: 20rpx;
		margin: 0 32rpx 32rpx;
		background: linear-gradient(135deg, #FFC15E, #FF9A6B);
		border-radius: 40rpx;
		cursor: pointer;
	}

	.read-all-btn:active {
		opacity: 0.8;
	}

	.btn-icon {
		font-size: 32rpx;
		margin-right: 8rpx;
	}

	.btn-text {
		font-size: 28rpx;
		color: #fff;
		font-weight: bold;
	}
</style>