<template>
  <view class="learn-body">
    <text class="pinyin">{{ pinyin }}</text>
    <MiGrid :width="size" :height="size">
      <image
        :style="{ width: size, height: size }"
        :src="svgDataUrl"
        mode="aspectFit"
        class="char-img"
      />
    </MiGrid>
    <view class="word-row">
      <swiper
        class="swiper"
        circular
        :indicator-dots="true"
        :autoplay="false"
        :interval="2000"
        :duration="500"
        @change="onSwiperChange"
      >
        <swiper-item :current="currentIndex" v-for="(item, i) in charInfo?.entries" :key="i">
          <view class="word-chip" v-for="(w, i) in item?.meanings" :key="i">
            <text class="word-num">{{ i + 1 }}</text>
            <text class="word-text">{{ w }}</text>
          </view>
        </swiper-item>
      </swiper>
    </view>
  </view>
</template>

<script setup lang="uts">
import { ref, onMounted, computed, watchEffect } from "vue";
import { MiGrid } from "@/components/MiGrid.uvue";
import { StrokeData } from "@literacy/shared-types";
import { loadStrokeData, Stroke, strokesToSvgDataUrl } from "@/utils/write";
import { speakText } from "@/utils/tts";
import { getCharInfo } from "@/api/char.ts";

const props = defineProps<{
  char: string;
}>();

const size = ref("548rpx");

const charInfo = ref(null);
const strokeList = ref<Array<Stroke>>(null);
const currentIndex = ref(0);
const pinyin = ref("");
const meanings = ref([]);

// 滑动切换处理
function onSwiperChange(e: any) {
  const newIndex = e.detail.current;
  currentIndex.value = newIndex;
}

watch(
  () => props.char,
  async (char) => {
    if (!char) {
      strokeList.value = [];
      return;
    }
    // // 1.渲染字
    // const strokeData = await loadStrokeData(char);
    // if (strokeData === null) {
    //   strokeList.value = null;
    //   return;
    // }
    // const { strokes, radStrokes } = strokeData;
    // strokeList.value = strokes.map((stroke, index) => ({
    //   d: stroke,
    //   color: radStrokes?.includes(index) ? "#e06a4d" : "#35543f"
    // }));
  },
  { immediate: true }
);

watchEffect(async () => {
  const char = props.char;
  const currentIdx = currentIndex.value;
  if (char) {
    charInfo.value = await getCharInfo(char); // 获取字信息
    if (charInfo.value) {
      const entries = charInfo.value?.entries;
      if (entries && entries.length > 0) {
        const currentInfo = entries[currentIdx];
        const [p, z] = currentInfo?.pinyin.split("|");
        pinyin.value = p;
        // let audio = await speakText(z); // 2.读字
      }
    }
  }
});

const svgDataUrl = computed(() => strokesToSvgDataUrl(strokeList.value));
</script>

<style>
.learn-body {
  align-items: center;
  padding: 6rpx 34rpx 0;
}

.pinyin {
  font-size: 40rpx;
  color: #7b9e84;
  font-weight: bold;
}

.word-row {
  width: 590rpx;
  margin-top: 20rpx;
  flex-direction: row;
  flex-wrap: wrap;
}

.word-chip {
  margin-top: 10rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: row;
  align-items: flex-start;
  gap: 9rpx;
  padding: 14rpx 24rpx;
  width: 100%;
  border-radius: 16rpx;
  background: #fff;
  border: 2rpx solid #ffeadd;
  box-shadow: 0 4rpx 10rpx -6rpx rgba(255, 138, 92, 0.4);
}
.word-num {
  flex: 0 0 40rpx;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  text-align: center;
  line-height: 40rpx;
  font-size: 22rpx;
  font-weight: 800;
  color: #fff;
  margin-top: 1rpx;
}

.word-text {
  flex: 1;
  font-size: 30rpx;
  color: #35543f;
  white-space: normal;
  word-wrap: break-word;
  line-height: 1.65;
}

.word-chip:nth-child(2n + 1) .word-num {
  background: #ff8a5c;
}
.word-chip:nth-child(2n) .word-num {
  background: #4ecdc4;
}
.word-chip:nth-child(3n) .word-num {
  background: #a06cd5;
}
.word-chip:nth-child(1) {
  border-color: #ffe2d2;
}
.word-chip:nth-child(2) {
  border-color: #d4f4f1;
  background: #fbffff;
}
.word-chip:nth-child(3) {
  border-color: #ecdffa;
  background: #fdfaff;
}
.swiper {
  width: 100%;
}
.swiper-item {
  display: block;
  height: 300rpx;
  line-height: 300rpx;
  text-align: center;
}
</style>
