<template>
	<view class="page">
		<dec></dec>
		<view class="container">
			<!-- 空状态 -->
			<view class="empty" v-if="!processing && results.length === 0">
				<text>点击下方按钮开始拍照或选择相册图片</text>
			</view>

			<view class="img-list" v-if="results.length > 0">
				<view v-for="(p, i) in results" :key="p.id" class="swipe-item">
					<!-- 删除按钮（底层） -->
					<view class="card-delete-btn" @tap.stop="deleteCard(i)">
						<text>删除</text>
					</view>

					<!-- 卡片内容（上层，跟手滑动） -->
					<view class="img-card" :style="cardSlideStyle(p)" @touchstart="touchStart($event, i)"
						@touchmove="touchMove($event, i)" @touchend="touchEnd($event, i)">
						<view class="img-slide-wrapper">
							<view class="img-main" @tap="previewImg(p.id)">
								<image :src="p.id" mode="aspectFill" class="thumb" />
								<view class="img-no-overlay">第{{ i + 1 }}张</view>
								<view v-if="!p.success && !p.error" class="img-loading-overlay">识别中...</view>
								<view v-else-if="p.error" class="img-error-overlay">失败</view>
							</view>
						</view>
						<view class="char-box">
							<view class="char-row">
								<template v-if="p.chars && p.chars.length">
									<view v-for="(char, charIdx) in p.chars" :key="charIdx" class="mi-cell"
										@longpress="deleteChar(i, charIdx)">
										<text class="mi-char">{{ char }}</text>
										<view class="mi-grid-bg"></view>
									</view>
								</template>
								<view v-else-if="p.success" class="empty-line">（无文字）</view>

								<view v-if="p.success && !p.error" class="add-cell" @tap="showAddDialog(i)">
									<text class="add-icon">+</text>
								</view>
							</view>
						</view>
					</view>
				</view>
			</view>
		</view>

		<view class="bottom-placeholder" v-if="results.length > 0"></view>

		<view class="bottom-bar">
			<button class="pick-btn" @tap="onPick" :disabled="processing">
				{{ processing ? '...' : ' 选择绘本图片（最多9张）' }}
			</button>
		</view>
	</view>
</template>

<script setup lang="ts">
	import { ref } from 'vue';
	import { onUnload } from '@dcloudio/uni-app';
	import { BASE_URL, API_KEY } from '@literacy/shared-config';
	import { setOcrResult } from '@/stores/ocr';

	interface OCRDetail {
		text : string;
		score : number;
		box : number[][];
	}

	const DELETE_BTN_WIDTH = 165;

	interface PageResult {
		id : string;
		originalId : string;
		index : number;
		success : boolean;
		chars : string[];
		detail : OCRDetail[];
		elapse : string;
		error ?: string;
		offsetX : number;
		animating : boolean;
	}

	interface ChooseImageResult {
		tempFilePaths : string[];
		tempFiles : Array<{ path : string; size : number; name ?: string }>;
	}

	const processing = ref(false);
	const results = ref<PageResult[]>([]);
	const progress = ref('');

	function cardSlideStyle(p : PageResult) : Record<string, string> {
		return {
			transform: 'translateX(' + p.offsetX + 'rpx)',
			transition: p.animating ? 'transform 0.28s ease' : 'none'
		};
	}

	// ===== 工具函数：临时路径转base64（只用临时路径） =====
	function tempPathToBase64(filePath : string) : Promise<string> {
		return new Promise((resolve, reject) => {
			uni.compressImage({
				src: filePath,
				quality: 80,
				compressedWidth: 1280,
				success: (cmp) => {
					uni.getFileSystemManager().readFile({
						filePath: cmp.tempFilePath,
						encoding: 'base64',
						success: (r) => resolve('data:image/jpeg;base64,' + r.data),
						fail: reject
					});
				},
				fail: reject
			});
		});
	}

	// ===== 工具函数：持久化图片（只在退出时调用） =====
	function saveImageToPersistent(tempPath : string) : Promise<string> {
		return new Promise((resolve, reject) => {
			const fs = uni.getFileSystemManager();
			fs.saveFile({
				tempFilePath: tempPath,
				success: (res) => resolve(res.savedFilePath),
				fail: (err) => {
					console.warn('saveFile失败', err);
					reject(err);
				}
			});
		});
	}

	// ===== 选图 =====
	function chooseImages() : Promise<string[]> {
		return new Promise((resolve, reject) => {
			uni.chooseImage({
				count: 9,
				sizeType: ['compressed'],
				sourceType: ['album', 'camera'],
				success: (res : ChooseImageResult) => resolve(res.tempFilePaths),
				fail: (err : any) => reject(err)
			});
		});
	}

	// ===== 单张OCR识别 =====
	function singleOcr(base64Str : string) : Promise<{ elapse : string; lines : string[] }> {
		return new Promise((resolve, reject) => {
			uni.request({
				url: BASE_URL + '/ocr/single',
				method: 'POST',
				header: { 'Content-Type': 'application/json', 'X-API-Key': API_KEY },
				data: { image_base64: base64Str },
				timeout: 30000,
				success: (res : any) => {
					const data = res.data;
					if (res.statusCode === 200 && data?.success) {
						resolve({ elapse: data.elapse || '0.8s', lines: data.lines || [] });
					} else {
						reject(new Error(data?.error || '识别失败'));
					}
				},
				fail: (err : any) => reject(err)
			});
		});
	}

	// ===== 主流程：选图 → 识别（不持久化） =====
	async function onPick() {
		try {
			processing.value = true;
			progress.value = '';
			const paths = await chooseImages();
			if (!paths.length) return;

			progress.value = '开始识别 ' + paths.length + ' 张...';
			const startIndex = results.value.length;

			// 先插入占位（用临时路径）
			paths.forEach((tmpPath, offset) => {
				const index = startIndex + offset;
				results.value.push({
					id: tmpPath,
					originalId: tmpPath,
					index,
					success: false,
					chars: [],
					detail: [],
					elapse: '',
					offsetX: 0,
					animating: false
				});
			});

			// 逐张识别（用临时路径压缩转base64）
			const promises = paths.map(async (tmpPath, offset) => {
				const index = startIndex + offset;
				try {
					const base64 = await tempPathToBase64(tmpPath);
					const result = await singleOcr(base64);

					const target = results.value.find(r => r.index === index);
					if (target) {
						target.success = true;
						target.chars = result.lines.join('').split('');
						target.elapse = result.elapse;
					}
				} catch (err : any) {
					const target = results.value.find(r => r.index === index);
					if (target) {
						target.error = err.message;
					}
				}
			});

			await Promise.all(promises);
			progress.value = '完成！';
		} catch (e : any) {
			uni.showToast({ title: '出错：' + (e.message || e.errMsg || '未知错误'), icon: 'none' });
		} finally {
			processing.value = false;
		}
	}

	// ===== 图片预览 =====
	function previewImg(url : string) {
		uni.previewImage({ urls: [url] });
	}

	// ===== 左滑删除手势 =====
	let touchData : {
		startX : number;
		startY : number;
		index : number;
		isHorizontal : boolean | null;
	} | null = null;

	function touchStart(e : any, index : number) {
		for (let i = 0; i < results.value.length; i++) {
			const r = results.value[i];
			if (i !== index && r.offsetX !== 0) {
				r.animating = true;
				r.offsetX = 0;
			}
		}

		touchData = {
			startX: e.touches[0].clientX,
			startY: e.touches[0].clientY,
			index,
			isHorizontal: null
		};
	}

	function touchMove(e : any, index : number) {
		if (!touchData || touchData.index !== index) return;

		const moveX = e.touches[0].clientX - touchData.startX;
		const moveY = e.touches[0].clientY - touchData.startY;

		if (touchData.isHorizontal === null) {
			if (Math.abs(moveX) < 8 && Math.abs(moveY) < 8) return;
			touchData.isHorizontal = Math.abs(moveX) >= Math.abs(moveY);
		}

		if (touchData.isHorizontal === false) return;

		const item = results.value[index];
		if (!item) return;

		if (moveX > 0) {
			item.animating = false;
			item.offsetX = 0;
			return;
		}

		let offset = moveX * 2;
		if (offset < -DELETE_BTN_WIDTH) offset = -DELETE_BTN_WIDTH;

		item.animating = false;
		item.offsetX = offset;
	}

	function touchEnd(e : any, index : number) {
		if (!touchData || touchData.index !== index) return;
		const wasHorizontal = touchData.isHorizontal;
		touchData = null;

		const item = results.value[index];
		if (!item) return;

		if (wasHorizontal === false) return;

		item.animating = true;
		if (item.offsetX <= -DELETE_BTN_WIDTH / 2) {
			item.offsetX = -DELETE_BTN_WIDTH;
		} else {
			item.offsetX = 0;
		}
	}

	function deleteCard(imgIndex : number) {
		const target = results.value[imgIndex];
		if (!target) return;
		uni.showModal({
			title: '提示',
			content: '确定删除「第' + (imgIndex + 1) + '张」及其识别结果吗？',
			success: (res) => {
				if (res.confirm) {
					results.value.splice(imgIndex, 1);
					uni.vibrateShort();
				} else if (target) {
					target.animating = true;
					target.offsetX = 0;
				}
			}
		});
	}

	function deleteChar(imgIndex : number, charIdx : number) {
		const target = results.value[imgIndex];
		if (!target || !target.chars[charIdx]) return;
		uni.showModal({
			title: '提示',
			content: '确定删除「' + target.chars[charIdx] + '」？',
			success: (res) => {
				if (res.confirm) {
					target.chars.splice(charIdx, 1);
					uni.vibrateShort();
				}
			}
		});
	}

	function showAddDialog(imgIndex : number) {
		const target = results.value[imgIndex];
		if (!target) return;
		uni.showModal({
			title: '添加文字',
			content: '',
			editable: true,
			placeholderText: '输入要添加的字',
			success: (res) => {
				if (res.confirm && res.content) {
					target.chars.push(...res.content.split(''));
				}
			}
		});
	}

	// ===== 退出时只处理第一张图片（带压缩） =====
	onUnload(async () => {
		const firstItem = results.value[0];
		if (!firstItem) return;

		// 收集所有条目的识别结果
		const allChars = results.value
			.filter(r => r.success && r.chars && r.chars.length > 0)
			.map(r => r.chars.join(''))
			.join('');

		// 先压缩再持久化（节省空间）
		let finalId = firstItem.id;
		if (firstItem.originalId) {
			try {
				// 压缩图片
				const compressResult = await new Promise<any>((resolve, reject) => {
					uni.compressImage({
						src: firstItem.originalId,
						quality: 60,       // 可以更低，60够用
						compressedWidth: 800, // 封面不需要太大
						success: resolve,
						fail: reject
					});
				});

				// 保存压缩后的图片
				const savedPath = await saveImageToPersistent(compressResult.tempFilePath);
				finalId = savedPath;
			} catch (e) {
				console.warn('压缩/持久化失败，使用原路径', e);
			}
		}

		const summary = [{
			id: finalId,
			title: firstItem.chars?.join('') || '',
			chars: allChars,
			progress: 0
		}];

		setOcrResult(summary);
		console.log('OCR页面退出，已保存数据：', summary);
	});
</script>

<style scoped>
	.page {
		position: relative;
		width: 100%;
		height: 100vh;
		overflow-y: auto;
		-webkit-overflow-scrolling: touch;
		background: rgba(241, 223, 196, 0.53);
	}

	.container {
		padding: 20px 20px 0;
	}

	.empty {
		margin-top: 40vh;
		text-align: center;
		font-size: 28rpx;
		color: #836c52;
	}

	.img-list {
		display: flex;
		flex-direction: column;
		padding: 16rpx;
	}

	.swipe-item {
		position: relative;
		margin-bottom: 28rpx;
		border-radius: 14rpx;
		overflow: hidden;
	}

	.card-delete-btn {
		position: absolute;
		right: 0;
		top: 0;
		bottom: 0;
		width: 155rpx;
		background: #ff4444;
		color: #fff;
		font-size: 28rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1;
		border-radius: 14rpx;
	}

	.img-card {
		position: relative;
		z-index: 2;
		background: rgb(254, 248, 237);
		border-radius: 14rpx;
		padding: 16rpx 18rpx;
		display: flex;
		flex-direction: row;
		align-items: flex-start;
		will-change: transform;
		box-shadow: 0 2rpx 8rpx rgba(139, 112, 78, 0.05);
	}

	.img-slide-wrapper {
		width: 142rpx;
		height: 106rpx;
		flex-shrink: 0;
		margin-right: 16rpx;
		border-radius: 8rpx;
		overflow: hidden;
	}

	.img-main {
		width: 100%;
		height: 100%;
		position: relative;
	}

	.thumb {
		width: 100%;
		height: 100%;
		border-radius: 8rpx;
		display: block;
	}

	.img-no-overlay {
		position: absolute;
		top: 4rpx;
		left: 6rpx;
		z-index: 2;
		font-size: 20rpx;
		color: #fff;
		text-shadow: 0 1rpx 2rpx rgba(0, 0, 0, 0.6);
		background: rgba(105, 86, 62, 0.42);
		padding: 2rpx 8rpx;
		border-radius: 4rpx;
	}

	.img-loading-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 2;
		font-size: 20rpx;
		color: #fff;
		background: rgba(119, 100, 74, 0.53);
		text-align: center;
		padding: 3rpx 0;
	}

	.img-error-overlay {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		z-index: 2;
		font-size: 20rpx;
		color: #fff;
		background: rgba(216, 60, 48, 0.66);
		text-align: center;
		padding: 3rpx 0;
	}

	.char-box {
		flex: 1;
		min-width: 0;
	}

	.char-row {
		display: flex;
		flex-direction: row;
		flex-wrap: wrap;
		align-items: center;
	}

	.mi-cell {
		width: 56rpx;
		height: 60rpx;
		margin: 3rpx;
		position: relative;
		display: flex;
		align-items: center;
		justify-content: center;
		flex-shrink: 0;
	}

	.mi-grid-bg {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		z-index: 1;
		border: 1rpx solid #c1ae98;
		background:
			linear-gradient(to right, transparent 48%, #ddd0be 48%, #ddd0be 52%, transparent 52%),
			linear-gradient(to bottom, transparent 47%, #ddd0be 47%, #ddd0be 53%, transparent 53%),
			linear-gradient(45deg, transparent 48%, #e8ddce 48%, #e8ddce 52%, transparent 52%),
			linear-gradient(-45deg, transparent 48%, #e8ddce 48%, #e8ddce 52%, transparent 52%);
		background-color: rgba(229, 218, 203, 0.01);
	}

	.mi-char {
		position: relative;
		z-index: 2;
		font-size: 26rpx;
		color: #362b1f;
	}

	.add-cell {
		width: 52rpx;
		height: 56rpx;
		margin: 3rpx;
		display: flex;
		align-items: center;
		justify-content: center;
		border: 2rpx dashed #c1ae98;
		border-radius: 4rpx;
		flex-shrink: 0;
	}

	.add-icon {
		font-size: 30rpx;
		color: #c1ae98;
	}

	.empty-line {
		padding: 6rpx;
		color: #bba992;
		font-size: 20rpx;
	}

	.bottom-placeholder {
		height: 144rpx;
	}

	.bottom-bar {
		position: fixed;
		bottom: 0;
		left: 0;
		right: 0;
		padding: 20rpx 30rpx 40rpx;
		background: linear-gradient(to top, rgba(244, 221, 178, 0.928), rgba(236, 209, 158, 0));
		z-index: 299;
	}

	.pick-btn {
		width: 610rpx;
		margin-left: 25rpx;
		height: 86rpx;
		line-height: 84rpx;
		background: #c19a6b;
		color: #ffffff;
		font-size: 29rpx;
		border-radius: 43rpx;
		box-shadow: 0 6rpx 16rpx rgba(173, 137, 91, 0.322);
		border: none;
	}

	.pick-btn[disabled] {
		background: #dbc6af;
		color: #f7efde;
		box-shadow: none;
	}

	button::after {
		border: none;
	}
</style>