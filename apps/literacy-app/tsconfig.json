{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "types": [
      "vue",
      "@dcloudio/types",
      "@types/wechat-miniprogram",
      "@uni-helper/uni-app-types"
    ]
  },
  "include": [
    "src/**/*.ts",
    "*.d.ts",
    "*.tsx",
    "*.vue",
    "*.uvue",
    "packages/**/*.ts",
    "shims-uni.d.ts"
  ]
}